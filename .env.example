# OpenModel — Docker Environment Variables
# Copy to .env and fill in actual values: cp .env.example .env

# Config file selection (filename under config/ directory)
# Options: sidecar-mainnet-alpha.yaml (alpha onboarding), sidecar-prod-test.yaml,
#          sidecar-8gpu-multi.yaml, sidecar-8gpu-tensor.yaml, sidecar-foc.yaml
SIDECAR_CONFIG=sidecar-prod-test.yaml

# Lotus daemon
# REQUIRED for gateway self-registration (WalletSign): a Lotus API token with
# sign permission or higher — usually `cat ~/.lotus/token`, or create one with
# `lotus auth create-token --perm sign`. (An unfilled value fails the wallet
# probe with a clear error; the old `eyJ...` placeholder looked like a real
# JWT prefix and silently corrupted append-style edits.)
LOTUS_API_TOKEN=

# HuggingFace
HF_ENDPOINT=https://huggingface.co
HF_TOKEN=
HF_CACHE_DIR=~/.cache/huggingface

# Model cache directory (shared by inference and foc-bridge)
MODEL_CACHE_DIR=~/openmodel/models

# FOC Bridge（Filecoin Onchain Cloud）
FOC_PRIVATE_KEY=
FOC_BRIDGE_PORT=3100

# Retrieval endpoints must match the chain the weights actually live on. Piece
# CIDs are content-addressed, so the same model has the same CID on both chains
# — "the download worked" does not prove it came from the chain you intended,
# and a model uploaded only to mainnet is simply unreachable via calibration
# endpoints. The production model catalog lives on MAINNET.
FOC_RPC_URL=https://api.node.glif.io/rpc/v1
SP_URL_PRIMARY=https://pdp.lotus.dedyn.io/piece
SP_URL_SECONDARY=https://pdp.lotus.dedyn.io/piece

# Calibration (testing):
# FOC_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
# SP_URL_PRIMARY=https://caliberation-pdp.infrafolio.com/piece
# SP_URL_SECONDARY=https://calib2.ezpdpz.net/piece

# Static inference API token (recommended). Clients and the verify commands use
# it as `Authorization: Bearer $INFERENCE_API_TOKEN`. After gateway registration
# a dynamic per-worker token is ALSO accepted; leaving this empty keeps the API
# open on trusted LANs only.
INFERENCE_API_TOKEN=change-me
